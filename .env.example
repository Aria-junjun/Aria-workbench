# Server-side access control
WORKBENCH_PASSWORD=replace-with-a-strong-password
WORKBENCH_SESSION_SECRET=replace-with-a-long-random-secret

# Supabase server connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Optional AI extraction
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini

# Optional stable single-user identifier for MVP data linking
SUPABASE_MVP_USER_ID=00000000-0000-0000-0000-000000000001
